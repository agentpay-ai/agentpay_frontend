# ==============================================================================
# AgentPay AI Web Application (Next.js 16 Frontend) - Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Network Environment Mode
# 
# NEXT_PUBLIC_ENVIRONMENT:
#   - "production"  : Mainnet Mode — Connects to BotChain Mainnet (Chain ID 677)
#   - "development" : Testnet Mode — Connects to BotChain Testnet (Chain ID 968)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENVIRONMENT="production"

# ------------------------------------------------------------------------------
# Backend API Gateway Endpoint
# 
# Production  : "https://agentpay-backend-c7c5.onrender.com" (Render Gateway)
# Development : "http://localhost:3001" (Local Express Gateway)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://agentpay-backend-c7c5.onrender.com"

# ------------------------------------------------------------------------------
# Privy Authentication App ID
# Get app ID from Privy Dashboard: https://dashboard.privy.io/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id_here"

# ------------------------------------------------------------------------------
# Optional Multi-Chain Contract Override Environment Variables
# ------------------------------------------------------------------------------
# BotChain Testnet Contracts (Chain ID 968)
NEXT_PUBLIC_APAY_TOKEN_ADDRESS_TESTNET="0xFd7bF688d5a772A81DfE39da502F69FD99cE92c7"
NEXT_PUBLIC_USDT_TOKEN_ADDRESS_TESTNET="0x75edC9335175Fc0552D51D48439F229c10420fe3"

# BotChain Mainnet Contracts (Chain ID 677) - Set when contracts are deployed on Mainnet
NEXT_PUBLIC_APAY_TOKEN_ADDRESS_MAINNET=""
NEXT_PUBLIC_USDT_TOKEN_ADDRESS_MAINNET=""
NEXT_PUBLIC_BOUSDT_TOKEN_ADDRESS_MAINNET=""
NEXT_PUBLIC_AGENT_PAY_REGISTRY_MAINNET_ADDRESS=""
