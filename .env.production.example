# Template for deployed environments. Copy to .env.production and fill in real values.
#
# With NEXT_PUBLIC_ENVIRONMENT=production the network switcher is never rendered — the app
# uses whichever network the wallet is on, and the API only settles the network it is
# configured for (X402_NETWORK in apps/api/.env).

NEXT_PUBLIC_PRIVY_APP_ID=your_production_privy_app_id

# Deployed API gateway origin — replace with the real hostname.
NEXT_PUBLIC_API_URL=https://api.example.com

NEXT_PUBLIC_ENVIRONMENT=production
